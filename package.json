{
  "name": "admin-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "create": "node packages/cli/index.mjs create",
    "dev": "pnpm --dir templates/admin dev",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm test && pnpm --dir templates/admin verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:pack": "node packages/cli/pack.mjs"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.9.3",
    "@inquirer/prompts": "^7.5.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.8.0",
    "zod": "^3.24.4",
    "typescript": "~5.8.3",
    "@vue/compiler-sfc": "^3.5.13",
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "tar": "^7.4.3"
  }
}
