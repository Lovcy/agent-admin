{
  "name": "admin-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && node scripts/admin-kit.mjs layers:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:smoke": "playwright test --grep @smoke",
    "test:e2e": "playwright test",
    "doctor": "node scripts/admin-kit.mjs doctor",
    "ai:setup": "node scripts/admin-kit.mjs ai:setup",
    "api:sync": "node scripts/admin-kit.mjs api:sync",
    "api:generate": "node scripts/admin-kit.mjs api:generate",
    "api:check": "node scripts/admin-kit.mjs api:check",
    "source:read": "node scripts/admin-kit.mjs source:read",
    "task": "node scripts/admin-kit.mjs task",
    "verify": "node scripts/admin-kit.mjs verify"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "pinia": "^3.0.2",
    "element-plus": "^2.9.10",
    "@element-plus/icons-vue": "^2.3.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.13",
    "fast-xml-parser": "^5.2.5",
    "@apidevtools/json-schema-ref-parser": "^11.9.3",
    "@inquirer/prompts": "^7.5.0",
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@types/node": "^22.15.0",
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.1.0",
    "typescript-eslint": "^8.32.0",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "msw": "^2.8.4",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "vue-tsc": "^2.2.10",
    "zod": "^3.24.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
